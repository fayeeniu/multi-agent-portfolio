# OS
.DS_Store
Thumbs.db

# Secrets and local env (keep committed *.example files)
.env
.env.*
!.env.example
!.env*.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Runtime state (keep directory via var/.gitkeep)
/var/*
!/var/.gitkeep
/data/*
!/data/README.md

# Node / Next.js (also covered by dashboard/.gitignore)
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts
